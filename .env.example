# App
APP_NAME=cloudsentinel-api
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# Log
LOG_LEVEL=info

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=cloudsentinel
MYSQL_USER=cloudsentinel
MYSQL_PASSWORD=development-mysql-password
MYSQL_ROOT_PASSWORD=development-root-password
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=5m
MYSQL_CONNECT_TIMEOUT=5s
MYSQL_PING_TIMEOUT=3s
MYSQL_TLS_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=development-redis-password
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_PING_TIMEOUT=3s
REDIS_TLS_ENABLED=false

# JWT
JWT_SECRET=development-jwt-secret-change-me
JWT_ISSUER=cloudsentinel-api
JWT_EXPIRES_IN=2h

# Bootstrap
BOOTSTRAP_USER_USERNAME=admin
BOOTSTRAP_USER_PASSWORD=development-admin-password

# Scheduler
PROBE_SCHEDULER_INTERVAL=5s
PROBE_SCHEDULER_BATCH_SIZE=100

# Worker
PROBE_WORKER_COUNT=4
PROBE_QUEUE_CAPACITY=100
PROBE_STREAM_KEY=cloudsentinel:probe:executions
PROBE_CONSUMER_GROUP=cloudsentinel-probe-workers
PROBE_STREAM_READ_COUNT=10
PROBE_STREAM_BLOCK_TIMEOUT=5s
PROBE_MESSAGE_IDLE_TIMEOUT=30m
PROBE_PENDING_SCAN_INTERVAL=30s
PROBE_SHUTDOWN_TIMEOUT=30s

# Network
PROBE_ALLOW_PRIVATE_NETWORKS=true
PROBE_ALLOW_LOOPBACK=false

# Metrics
WORKER_METRICS_ADDRESS=:9091

# Alertmanager
ALERTMANAGER_WEBHOOK_TOKEN=development-webhook-token-change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=development-grafana-password
